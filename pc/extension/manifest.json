{
  "manifest_version": 3,
  "name": "MuteHaram",
  "version": "0.1.0",
  "description": "Open the video on this page in the MuteHaram player with the music removed.",
  "permissions": ["webRequest", "tabs", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47800/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Remove music (open in MuteHaram player)" }
}
