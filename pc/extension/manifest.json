{
  "manifest_version": 3,
  "name": "MuteHaram",
  "version": "0.3.0",
  "description": "Open the video on this page in the MuteHaram player with the music removed.",
  "permissions": [
    "webRequest",
    "tabs",
    "scripting",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:47800/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Remove music (open in MuteHaram player)",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "muteharam@local",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:47800/*"
      ],
      "js": [
        "library_bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
